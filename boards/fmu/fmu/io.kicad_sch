	(text "USB-C (SYS-036)"
		(exclude_from_sim no)
		(at 20 22 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c1b10c30-fbb3-5556-81f7-6ec470acc0bb")
	)
	(text "VBUS → PMEG3020 → +5V: yalnız USB'de MCU, sensörler, OSD ve 5 V çalışır; 5 V'tan VBUS'a geri besleme yok.\nUSBLC6 pin 1/6 ve 3/4 aynı hat (geçişli). PA9 VBUS algılama kullanılmaz (UART1)."
		(exclude_from_sim no)
		(at 20 120 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "09619ffa-4bc3-5097-91d8-47000a18cfaa")
	)
	(text "ESC konnektörleri SM08B (SYS-037, SYS-060…062; dizilim tablosu ESC_PINOUT, İP-10)"
		(exclude_from_sim no)
		(at 200 22 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "53e621a4-68f1-55d6-b840-870748799e26")
	)
	(text "Dizilim (esc55a J0, doğrulanacak): 1:CUR  2:TLM  3:M4  4:M3  5:M2  6:M1  7:VBAT  8:GND\nJ_ESC1: CUR → ESC1_CUR → PC1, TLM → UART5_RX (PD2), M1–M4.\nJ_ESC2 (Dual SKU, standart SKU'da DNP): CUR → PC5, TLM boş, M5–M8; VBAT → R503 0 Ω DNP."
		(exclude_from_sim no)
		(at 200 86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f779a3c4-5717-5f56-9027-b449ee1ea50c")
	)
	(text "Alıcı, DJI, GPS konnektörleri (SYS-035, SYS-065) — cihaz tarafı dizilimi doğrulanacak"
		(exclude_from_sim no)
		(at 20 140 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2b76bb64-3774-599c-900c-87c4f000b2e8")
	)
	(text "SBUS ters çevirici (SYS-035)"
		(exclude_from_sim no)
		(at 200 140 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b1396ee6-06cf-5f12-bd11-a27542d8013a")
	)
	(text "SBUS pedi (veya DJI pin 6) → 74LVC1G04 → 1k → PA3 (UART2 RX). CRSF alıcı doğrudan RX2'yi\nsürer; 1k çevirici çıkışını ezmesine izin verir."
		(exclude_from_sim no)
		(at 200 193 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "14fb6e46-8e66-5f04-8db4-edd5b9ed1bcd")
	)
