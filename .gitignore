# KiCad local / autosave
*-backups/
boards/*/checkpoints/
*_bak
*.kicad_pcb-bak
*.kicad_sch-bak
*-save.kicad_pcb
*-save.kicad_sch
fp-info-cache
*.lck
*.kicad_prl
.history/
~$*

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
.claude/*
!.claude/agents/
*.swp
*.tmp

# Python / local tools
.venv/
__pycache__/
*.pyc

# Optional local KiBot / Docker clutter
