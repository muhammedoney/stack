# Generated manufacturing / docs (policy: release artifact only — do not commit)
boards/*/Manufacturing/
boards/*/Schematic/
boards/*/Variants/
boards/*/HTML/
boards/*/Report/
boards/*/KiRI/

# Firmware build output
firmware/**/build/
firmware/**/obj/

# Altium local
*.$*.bkp
.$*
boards/*/altium/History/
boards/*/altium/Project Logs*/
boards/*/altium/Project Outputs*/
__Previews/

# JLC fiyat önbelleği (tools/jlc.py)
tools/jlc_cache.json
